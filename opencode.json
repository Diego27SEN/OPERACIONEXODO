{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "unityMCP": {
      "enabled": false
    },
    "unrealopencode": {
      "type": "local",
      "command": [
        "node",
        "Plugins/UnrealOpenCode/Resources/MCPServer/dist/index.js"
      ],
      "enabled": true,
      "environment": {
        "UEOC_HOST": "localhost",
        "UEOC_PORT": "3000"
      }
    }
  }
}